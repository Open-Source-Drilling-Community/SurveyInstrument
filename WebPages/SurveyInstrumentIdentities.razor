@page "/SurveyInstrumentIdentities"
@inject ISurveyInstrumentAPIUtils Api
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">Survey Instrument Identities</MudText>
<MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="Add">Add identity</MudButton>
<MudButton Color="Color.Primary" Variant="Variant.Filled" Class="ml-2" OnClick="SaveAsync">Save</MudButton>
<MudTable Items="items" Dense="true" Hover="true" Class="mt-4">
    <HeaderContent><MudTh>Name</MudTh><MudTh></MudTh></HeaderContent>
    <RowTemplate>
        <MudTd><MudTextField @bind-Value="context.Name" /></MudTd>
        <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" /></MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<SurveyInstrumentIdentity> items = [];

    protected override async Task OnInitializedAsync() =>
        items = (await Api.ClientSurveyInstrument.GetAllSurveyInstrumentIdentityAsync()).ToList();

    private void Add() => items.Add(new() { MetaInfo = new() { ID = Guid.NewGuid() } });

    private async Task SaveAsync()
    {
        HashSet<Guid> existing = (await Api.ClientSurveyInstrument.GetAllSurveyInstrumentIdentityIdAsync()).ToHashSet();
        foreach (SurveyInstrumentIdentity item in items)
        {
            if (existing.Contains(item.MetaInfo.ID))
                await Api.ClientSurveyInstrument.PutSurveyInstrumentIdentityByIdAsync(item.MetaInfo.ID, item.LastModificationDate, item);
            else
                await Api.ClientSurveyInstrument.PostSurveyInstrumentIdentityAsync(item);
        }
        items = (await Api.ClientSurveyInstrument.GetAllSurveyInstrumentIdentityAsync()).ToList();
        Snackbar.Add("Identities saved", Severity.Success);
    }

    private async Task DeleteAsync(SurveyInstrumentIdentity item)
    {
        if (item.LastModificationDate == null)
        {
            items.Remove(item);
            return;
        }
        try
        {
            await Api.ClientSurveyInstrument.DeleteSurveyInstrumentIdentityByIdAsync(item.MetaInfo.ID, item.LastModificationDate);
            items.Remove(item);
        }
        catch (ApiException exception) when (exception.StatusCode == 409)
        {
            Snackbar.Add("This identity is in use and cannot be deleted.", Severity.Warning);
        }
    }
}
