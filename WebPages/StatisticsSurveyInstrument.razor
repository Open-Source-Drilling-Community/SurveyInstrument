@page "/StatisticsSurveyInstrument"
@using System.Reflection
@inject ILogger<StatisticsSurveyInstrument> logger
@inject ISnackbar Snackbar
@inject ISurveyInstrumentAPIUtils Api

<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-4">
        <div>
            <MudText Typo="Typo.h5"><strong>Usage Statistics</strong></MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Survey Instrument service requests retained across restarts by the persistent service data volume.
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@isLoading_" OnClick="RefreshAsync">Refresh</MudButton>
    </MudStack>

    @if (isLoading_)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (statistics_ == null)
    {
        <MudAlert Severity="Severity.Warning">Unable to load Survey Instrument usage statistics.</MudAlert>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.subtitle2">Total requests</MudText>
                <MudText Typo="Typo.h6">@totalCount_</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.subtitle2">Today (UTC)</MudText>
                <MudText Typo="Typo.h6">@todayCount_</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.subtitle2">Tracked endpoints</MudText>
                <MudText Typo="Typo.h6">@rows_.Count</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.subtitle2">Last saved</MudText>
                <MudText Typo="Typo.h6">@FormatDate(statistics_.LastSaved)</MudText>
            </MudItem>
        </MudGrid>

        <MudTable Items="rows_" Dense="true" Hover="true" Bordered="true" Striped="true"
                  SortLabel="Sort by" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<UsageRow, string>(row => row.Method)">Method</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<UsageRow, string>(row => row.Endpoint)">Endpoint / operation</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<UsageRow, string>(row => row.Area)">Area</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<UsageRow, object>(row => row.Today)">Today</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<UsageRow, object>(row => row.Total)">Total</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<UsageRow, object>(row => row.LastUsed ?? DateTimeOffset.MinValue)">Last used</MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Method">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@MethodColor(context.Method)">@context.Method</MudChip>
                </MudTd>
                <MudTd DataLabel="Endpoint / operation">@context.Endpoint</MudTd>
                <MudTd DataLabel="Area">@context.Area</MudTd>
                <MudTd DataLabel="Today">@context.Today</MudTd>
                <MudTd DataLabel="Total">@context.Total</MudTd>
                <MudTd DataLabel="Last used">@FormatDate(context.LastUsed)</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>No usage counters were returned by the Survey Instrument service.</MudText>
            </NoRecordsContent>
        </MudTable>
    }
</MudStack>

@code {
    private UsageStatisticsSurveyInstrument? statistics_;
    private readonly List<UsageRow> rows_ = [];
    private long totalCount_;
    private long todayCount_;
    private bool isLoading_ = true;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        isLoading_ = true;
        try
        {
            statistics_ = await Api.ClientSurveyInstrument.GetSurveyInstrumentUsageStatisticsAsync();
            BuildRows();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Problem loading Survey Instrument usage statistics");
            statistics_ = null;
            ResetRows();
            Snackbar.Add("Unable to load Survey Instrument usage statistics.", Severity.Error);
        }
        finally
        {
            isLoading_ = false;
        }
    }

    private void BuildRows()
    {
        ResetRows();
        if (statistics_ == null)
        {
            return;
        }

        foreach (PropertyInfo property in typeof(UsageStatisticsSurveyInstrument)
                     .GetProperties(BindingFlags.Instance | BindingFlags.Public)
                     .Where(property => property.PropertyType == typeof(History) &&
                                        property.Name.EndsWith("PerDay", StringComparison.Ordinal))
                     .OrderBy(property => ToEndpointDescriptor(property.Name).Area, StringComparer.Ordinal)
                     .ThenBy(property => MethodSortOrder(ToEndpointDescriptor(property.Name).Method))
                     .ThenBy(property => ToEndpointDescriptor(property.Name).Endpoint, StringComparer.Ordinal))
        {
            if (property.GetValue(statistics_) is not History history)
            {
                continue;
            }

            EndpointDescriptor descriptor = ToEndpointDescriptor(property.Name);
            long total = Total(history);
            long today = Today(history);
            DateTimeOffset? lastUsed = LastUsed(history);
            totalCount_ += total;
            todayCount_ += today;
            rows_.Add(new UsageRow(descriptor.Method, descriptor.Endpoint, descriptor.Area, today, total, lastUsed));
        }
    }

    private void ResetRows()
    {
        rows_.Clear();
        totalCount_ = 0;
        todayCount_ = 0;
    }

    private static long Total(History history) =>
        history.Data?.Where(entry => entry != null).Sum(entry => entry.Count) ?? 0;

    private static long Today(History history)
    {
        DateTime utcToday = DateTime.UtcNow.Date;
        return history.Data?
            .Where(entry => entry != null && entry.Date.UtcDateTime.Date == utcToday)
            .Sum(entry => entry.Count) ?? 0;
    }

    private static DateTimeOffset? LastUsed(History history) =>
        history.Data?
            .Where(entry => entry != null && entry.Count > 0)
            .Select(entry => (DateTimeOffset?)entry.Date)
            .OrderByDescending(date => date)
            .FirstOrDefault();

    private static EndpointDescriptor ToEndpointDescriptor(string propertyName)
    {
        string name = propertyName.EndsWith("PerDay", StringComparison.Ordinal)
            ? propertyName[..^"PerDay".Length]
            : propertyName;
        string method = name switch
        {
            string value when value.StartsWith("Get", StringComparison.Ordinal) => "GET",
            string value when value.StartsWith("Post", StringComparison.Ordinal) => "POST",
            string value when value.StartsWith("Put", StringComparison.Ordinal) => "PUT",
            string value when value.StartsWith("Delete", StringComparison.Ordinal) => "DELETE",
            _ => "-"
        };
        string endpoint = SplitWords(RemoveMethodPrefix(name));
        string area = endpoint.Contains("Error Source", StringComparison.OrdinalIgnoreCase)
            ? "Error-source templates"
            : "Survey instruments";
        return new EndpointDescriptor(method, endpoint, area);
    }

    private static string RemoveMethodPrefix(string name)
    {
        foreach (string prefix in new[] { "GetAll", "Get", "Post", "Put", "Delete" })
        {
            if (name.StartsWith(prefix, StringComparison.Ordinal))
            {
                return name[prefix.Length..];
            }
        }
        return name;
    }

    private static string SplitWords(string value) =>
        string.Concat(value.Select((character, index) =>
            index > 0 && char.IsUpper(character) && !char.IsUpper(value[index - 1])
                ? " " + character
                : character.ToString()));

    private static int MethodSortOrder(string method) => method switch
    {
        "GET" => 0,
        "POST" => 1,
        "PUT" => 2,
        "DELETE" => 3,
        _ => 4
    };

    private static Color MethodColor(string method) => method switch
    {
        "GET" => Color.Info,
        "POST" => Color.Success,
        "PUT" => Color.Warning,
        "DELETE" => Color.Error,
        _ => Color.Default
    };

    private static string FormatDate(DateTimeOffset? value) =>
        value.HasValue && value.Value != default
            ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            : "-";

    private sealed record EndpointDescriptor(string Method, string Endpoint, string Area);
    private sealed record UsageRow(string Method, string Endpoint, string Area, long Today, long Total, DateTimeOffset? LastUsed);
}
