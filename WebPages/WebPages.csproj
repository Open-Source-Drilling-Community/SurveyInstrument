<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <AssemblyName>OSDC.Drilling.SurveyInstrument.WebPages</AssemblyName>
    <RootNamespace>OSDC.Drilling.SurveyInstrument.WebPages</RootNamespace>
    <PackageId>OSDC.Drilling.SurveyInstrument.WebPages</PackageId>
    <Title>OSDC.Drilling.SurveyInstrument.WebPages</Title>
    <Authors>Eric Cayeux</Authors>
    <Company>Open Source Drilling Community</Company>
    <Description>Reusable Razor class library containing the SurveyInstrument web pages.</Description>
    <PackageTags>surveyinstrument;drilling;blazor;razor;mudblazor</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Open-Source-Drilling-Community/SurveyInstrument</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Open-Source-Drilling-Community/SurveyInstrument</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ModelSharedOut\SurveyInstrumentMergedModel.cs" Link="GeneratedDtos\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OSDC.DotnetLibraries.Drilling.WebAppUtils" Version="1.1.2" />
  </ItemGroup>

</Project>
